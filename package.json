{
  "name": "tuyabar",
  "private": true,
  "version": "0.0.1",
  "description": "Controle local de dispositivos Tuya direto da barra de menu/bandeja.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "tsx --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "discover": "tsx apps/cli/src/discover.ts",
    "fake-device": "tsx apps/cli/src/fake-device.ts",
    "login": "tsx apps/cli/src/login.ts",
    "devices": "tsx apps/cli/src/devices.ts",
    "control": "tsx apps/cli/src/control.ts",
    "assets": "npm run assets -w @tuyabar/menubar"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuliocalil/tuyabar"
  },
  "author": "Tulio Calil"
}
