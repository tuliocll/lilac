{
  "name": "lilac",
  "private": true,
  "version": "0.0.1",
  "description": "Control your Tuya / Smart Life gadgets from the menu bar — over your own network.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "tsx --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "test:txiki": "tsx packages/transport-txiki/smoke/run.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "discover": "tsx apps/cli/src/discover.ts",
    "fake-device": "tsx apps/cli/src/fake-device.ts",
    "login": "tsx apps/cli/src/login.ts",
    "devices": "tsx apps/cli/src/devices.ts",
    "control": "tsx apps/cli/src/control.ts",
    "assets": "npm run assets -w @lilac/menubar",
    "lg": "tsx apps/cli/src/lg.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuliocll/lilac"
  },
  "homepage": "https://github.com/tuliocll/lilac",
  "bugs": {
    "url": "https://github.com/tuliocll/lilac/issues"
  },
  "author": "Tulio Calil"
}
